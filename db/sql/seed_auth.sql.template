-- Demo login credentials. GENERATED -- see scripts/seed_auth.py.
--
-- Not a migration, for two reasons. It writes rows with role 'government' and
-- 'supplier', and Postgres will not let a transaction use enum values that the
-- same transaction added (migration b3f1c9d4a7e2 adds them). And demo
-- credentials are seed data, not schema -- a deployment that is not this demo
-- must be able to skip this file entirely.
--
-- Password for every account here: demo1234
--
-- The eight households and two field workers already exist: seed_demo.sql
-- creates them, numbered, with a placeholder hash that no password matches.
-- This file replaces that hash, so every seeded account can actually be signed
-- into. It used to do so for one household and one worker only, which left the
-- richest six households in the estate impossible to demonstrate.
--
-- The regulator and the supplier are created here rather than claimed: they
-- read the whole fleet and have no per-account data to inherit. Both get the
-- role-prefixed National ID scheme the rest of the estate uses --
-- 1_000_000_0NN consumer, 2_ worker, 3_ government, 4_ supplier -- and the
-- matching numbered full name, so a screen that identifies an account by name
-- names the same account as one that identifies it by address.
--
-- Idempotent: re-running overwrites the same accounts and claims nothing new.

BEGIN;

-- The eight households and two workers seed_demo.sql created.
UPDATE account
SET password_hash = '__HASH__',
    updated_at = now()
WHERE email IN (
    SELECT format('consumer%s@demo.com', n) FROM generate_series(1, 8) AS n
    UNION ALL
    SELECT format('worker%s@demo.com', n) FROM generate_series(1, 2) AS n
);

-- Regulator and supplier: created, not claimed.
INSERT INTO account (email, password_hash, full_name, national_id, role, status)
VALUES
    ('gov1@demo.com',      '__HASH__', 'Gov 1',      '3000000001', 'government', 'active'),
    ('supplier1@demo.com', '__HASH__', 'Supplier 1', '4000000001', 'supplier',   'active')
ON CONFLICT (email) DO UPDATE
SET password_hash = EXCLUDED.password_hash,
    full_name     = EXCLUDED.full_name,
    national_id   = EXCLUDED.national_id,
    role          = EXCLUDED.role,
    status        = 'active',
    updated_at    = now();

COMMIT;
