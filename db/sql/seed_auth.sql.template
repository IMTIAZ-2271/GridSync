-- Demo login credentials. GENERATED -- see scripts/seed_auth.py.
--
-- Not a migration, for two reasons. It writes rows with role 'government' and
-- 'supplier', and Postgres will not let a transaction use enum values that the
-- same transaction added (migration b3f1c9d4a7e2 adds them). And demo
-- credentials are seed data, not schema -- a deployment that is not this demo
-- must be able to skip this file entirely.
--
-- Password for every account here: demo1234
--
-- The eight households and two field workers already exist: seed_demo.sql
-- creates them, numbered, with a placeholder hash that no password matches.
-- This file replaces that hash, so every seeded account can actually be signed
-- into. It used to do so for one household and one worker only, which left the
-- richest six households in the estate impossible to demonstrate.
--
-- Staff are no longer created here. They were, back when the estate was one
-- regulator and one supplier with nothing behind them; now the roster in
-- db/sql/seed_orgs.sql owns who exists and which district or firm they belong
-- to, and this file owns only the credential. Splitting them is what lets
-- seed_orgs.sql be re-run to restaff a database without touching a password.
--
-- Idempotent: re-running overwrites the same accounts and claims nothing new.

BEGIN;

-- Every demo account: the eight households seed_demo.sql creates, and the ten
-- technicians, three officials and five installer staff db/sql/seed_orgs.sql
-- creates. All of them land with the placeholder hash that no password
-- matches; this is the file that makes them signable-into.
UPDATE account
SET password_hash = '__HASH__',
    updated_at = now()
WHERE email IN (
    SELECT format('consumer%s@demo.com', n) FROM generate_series(1, 8) AS n
    UNION ALL
    SELECT format('worker%s@demo.com', n) FROM generate_series(1, 10) AS n
    UNION ALL
    SELECT format('gov%s@demo.com', n) FROM generate_series(1, 3) AS n
    UNION ALL
    SELECT format('supplier%s@demo.com', n) FROM generate_series(1, 5) AS n
);

COMMIT;
