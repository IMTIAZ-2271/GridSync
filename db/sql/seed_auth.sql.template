-- Demo login accounts, one per role. GENERATED -- see scripts/seed_auth.py.
--
-- Not a migration, for two reasons. It writes rows with role 'government' and
-- 'supplier', and Postgres will not let a transaction use enum values that the
-- same transaction added (migration b3f1c9d4a7e2 adds them). And demo
-- credentials are seed data, not schema -- a deployment that is not this demo
-- must be able to skip this file entirely.
--
-- Password for all four: demo1234
--
-- Customer and worker CLAIM existing seeded accounts rather than creating new
-- ones, because those accounts already own the data the demo needs to show:
--
--   * Ayesha Rahman owns Seed Site 01 -- solar, two bills, a credit balance
--     and one open issue. Creating a new account and transferring the site
--     would work (that is what customer registration does), but claiming in
--     place also keeps the issue she reported attributed to her.
--   * Kamrul Islam is SEED-EMP-001 with six work-order assignments and three
--     skills, all of which reference worker_profile(account_id) -- which is
--     his account's primary key. Only claiming in place preserves them.
--
-- Government and supplier are new accounts; they read the whole fleet and have
-- no per-account data to inherit.
--
-- Idempotent: re-running overwrites the same four accounts and claims nothing
-- new. Safe to apply repeatedly.

BEGIN;

-- Customer: Ayesha Rahman, Seed Site 01 (Dhanmondi, solar).
UPDATE account
SET email = 'customer@demo.com',
    password_hash = '__HASH__',
    updated_at = now()
WHERE account_id = (
    SELECT s.account_id FROM site s WHERE s.label = 'Seed Site 01'
);

-- Worker: Kamrul Islam, employee SEED-EMP-001.
UPDATE account
SET email = 'worker@demo.com',
    password_hash = '__HASH__',
    updated_at = now()
WHERE account_id = (
    SELECT wp.account_id FROM worker_profile wp
    WHERE wp.employee_code = 'SEED-EMP-001'
);

-- Government and supplier: created, not claimed.
INSERT INTO account (email, password_hash, full_name, role, status)
VALUES
    ('gov@demo.com',      '__HASH__', 'Regulator Demo', 'government', 'active'),
    ('supplier@demo.com', '__HASH__', 'Utility Demo',   'supplier',   'active')
ON CONFLICT (email) DO UPDATE
SET password_hash = EXCLUDED.password_hash,
    full_name     = EXCLUDED.full_name,
    role          = EXCLUDED.role,
    status        = 'active',
    updated_at    = now();

COMMIT;
