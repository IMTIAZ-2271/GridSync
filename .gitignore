# file here meant to be public, so it is excluded from the pattern.
.env.*
!.env.example
__pycache__/
*.pyc
node_modules/
.venv/
CLAUDE.md
docs/
.venv/

# Frontend
web/node_modules/
web/dist/

# Generated by scripts/seed_auth.py (contains a freshly salted hash)
db/sql/seed_auth.sql

# Device ingest keys -- plaintext, dev only, never committed.
device_keys.json

# Local pre-reset database dumps -- large, and not the repo's business.
backups/
