# Copy to .env and fill in. .env is gitignored; this file is not.
# env.py rewrites the scheme to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/gridsync

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is deliberately no default -- the API refuses to start without it.
JWT_SECRET=
# Shared codes for government/supplier self-registration. Demo values.
GOV_REGISTRATION_CODE=GOV-2026
SUPPLIER_REGISTRATION_CODE=SUP-2026


# services/jobs. Everything here is optional -- the defaults in
# services/jobs/config.py are what the runner uses when these are unset.
#
# Scheduled billing is the one job that is OFF unless you turn it on. Bills are
# append-only (rule 1), so a scheduler left running writes rows nobody can take
# back. `python -m services.jobs --once billing` ignores this switch: it exists
# to stop billing running UNATTENDED, not to stop it running.
JOBS_BILLING_ENABLED=off
# JOBS_DEADLINE_SWEEP_MINUTES=5
# JOBS_ROLLUP_LOOKBACK_DAYS=3
# JOBS_PARTITION_MONTHS_AHEAD=3

# Deployment. The API and the site share an origin in dev (Vite proxies /api),
# so this is unset locally and the code falls back to the dev server's origins.
# A hosted front end is a different origin and must be named exactly --
# scheme included, no trailing slash. Comma-separated for more than one.
# CORS_ORIGINS=https://gridsync.pages.dev
