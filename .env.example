# Copy to .env and fill in. .env is gitignored; this file is not.
# env.py rewrites the scheme to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/gridsync

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is deliberately no default -- the API refuses to start without it.
JWT_SECRET=
# Shared codes for government/supplier self-registration. Demo values.
GOV_REGISTRATION_CODE=GOV-2026
SUPPLIER_REGISTRATION_CODE=SUP-2026

